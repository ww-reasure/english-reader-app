{
  "name": "english-reader-app",
  "version": "1.8.7",
  "description": "AI-powered English reading learning app with word translation, sentence analysis, and smart review",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx cap sync android",
    "build:apk": "npm run build && node scripts/build-apk.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "release:patch": "npm run version:patch && npm run build:apk",
    "release:minor": "npm run version:minor && npm run build:apk",
    "preview": "vite preview"
  },
  "keywords": [
    "english",
    "reading",
    "learning",
    "ai",
    "deepseek",
    "capacitor",
    "android"
  ],
  "author": "Wang Xiaoming",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@fortawesome/fontawesome-free": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ww-reasure/english-reader-app.git"
  },
  "bugs": {
    "url": "https://github.com/ww-reasure/english-reader-app/issues"
  },
  "homepage": "https://github.com/ww-reasure/english-reader-app#readme",
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.0.16"
  }
}
